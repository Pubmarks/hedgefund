# OpenCode auth — optional for opencode/big-pickle; required for paid providers
OPENCODE_API_KEY=
OPENCODE_DISABLE_DEFAULT_PLUGINS=1
OPENCODE_PURE=1

# OpenRouter — required when HEDGEFUND_*_MODEL uses openrouter/<model>
# OPENROUTER_API_KEY=

# OpenCode server URL — leave unset for subprocess mode (opencode acp, recommended)
# OPENCODE_SERVER_URL=http://127.0.0.1:4096

# Model tiers (OpenCode provider/model format; default is free opencode/big-pickle)
# HEDGEFUND_QUICK_MODEL=opencode/big-pickle
# HEDGEFUND_DEEP_MODEL=opencode/big-pickle
# HEDGEFUND_EPIC_MODEL=opencode/big-pickle
# Examples via OpenRouter:
# HEDGEFUND_QUICK_MODEL=openrouter/anthropic/claude-sonnet-4
# HEDGEFUND_DEEP_MODEL=openrouter/anthropic/claude-sonnet-4
# HEDGEFUND_EPIC_MODEL=openrouter/openai/gpt-4o

# Flat tools library
FRED_API_KEY=                    # required for fetch_macro_data
TOOLS_CACHE_DIR=./.cache         # optional; defaults to /data/cache
# AVGPE_BASE_URL=https://pubmarks.github.io/datasets/stocks/{ticker}

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=WARNING
